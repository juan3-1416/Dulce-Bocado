# Copia este archivo como .env.etl.local y completa las contrasenas LOCALMENTE.
# No lo subas al repositorio con contrasenas ni lo compartas por chat.
# Los nombres de bases/usuarios fueron verificados en los Compose del proyecto.

BI_SALES_HOST=sales-db
BI_SALES_PORT=5432
BI_SALES_DB=dulce_sales
BI_SALES_USER=dulce_sales_user
