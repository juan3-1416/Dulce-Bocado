APP_NAME="Dulce Bocado Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

SECURITY_SERVICE_URL=http://security-service:8000
INTERNAL_SERVICE_KEY=
SECURITY_TIMEOUT=3
CATALOGO_SERVICE_URL=http://catalog-service:8000
CATALOGO_SERVICE_KEY=
CATALOGO_TIMEOUT=3

DB_CONNECTION=pgsql
DB_HOST=inventory-db
DB_PORT=5432
DB_DATABASE=dulce_inventory
DB_USERNAME=dulce_inventory_user
DB_PASSWORD=

# Clave exclusiva compartida con Sales para las rutas /internal/ventas/*.
INVENTORY_SALES_KEY=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning
